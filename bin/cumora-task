#!/usr/bin/env python3
"""
Cumora Task System & Gateway CLI Tool (cumora-task)
统一任务系统客户端命令行工具，供所有 Agent (知夏, 承序, 求索, 修远, 靖安等) 开箱即用。

支持命令：
  cumora-task call --to <agent> --msg "<text>" [--from <agent>] [--timeout 60]
  cumora-task claim <taskId> [--token <claimToken>]
  cumora-task progress <taskId> --percent <0-100> --stage <stage> [--msg "<msg>"]
  cumora-task block <taskId> --reason "<reason>" [--helper <agent>]
  cumora-task complete <taskId> --result "<result>" [--token <claimToken>]
  cumora-task status <taskId>
  cumora-task agents
  cumora-task logs [--limit 10] [--to <agent>]

提示：对于外部 GitHub Issue，<taskId> 可直接使用 issue-<id> (如 issue-43)，系统自动建档与流转。
"""

import argparse
import json
import os
import ssl
import sys
import time
import urllib.request
import urllib.error

DEFAULT_GATEWAY_URL = os.environ.get("CUMORA_GATEWAY_URL", "https://192.168.123.253:5181")
DEFAULT_HOST_HEADER = os.environ.get("CUMORA_HOST_HEADER", "cumora.tailcbdcf8.ts.net")
DEFAULT_COMPANY_ID = os.environ.get("CUMORA_COMPANY_ID", "co-a661f129-6")
DEFAULT_A2A_TOKEN = os.environ.get("CUMORA_A2A_MASTER_TOKEN", "6d4c7949c030a6f4d434f992bd72187f0d42d73fdfb91b9a")

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def get_auth_token():
    # 优先环境变量
    token = os.environ.get("CUMORA_AUTH_TOKEN")
    if token and token.strip():
        return token.strip()
    # 其次检查本地 session token
    token_file = "/tmp/admin_session_token.txt"
    if os.path.exists(token_file):
        try:
            with open(token_file) as f:
                t = f.read().strip()
                if t:
                    return t
        except Exception:
            pass
    # 兜底内部 A2A Master Token
    return DEFAULT_A2A_TOKEN

def make_request(path, method="GET", body=None, timeout=30):
    url = f"{DEFAULT_GATEWAY_URL.rstrip('/')}{path}"
    headers = {
        "Host": DEFAULT_HOST_HEADER,
        "Authorization": f"Bearer {get_auth_token()}",
        "x-company-id": DEFAULT_COMPANY_ID,
    }
    data = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(body).encode("utf-8")

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=timeout) as resp:
            text = resp.read().decode("utf-8")
            try:
                return json.loads(text)
            except Exception:
                return {"raw": text, "status": resp.status}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8")
        try:
            err_json = json.loads(err_body)
            print(f"[Error {e.code}] {err_json.get('message') or err_json.get('error') or err_body}", file=sys.stderr)
            return err_json
        except Exception:
            print(f"[Error {e.code}] {err_body}", file=sys.stderr)
            return {"error": f"HTTP {e.code}", "detail": err_body}
    except Exception as e:
        print(f"[Network Error] {e}", file=sys.stderr)
        return {"error": "network_error", "detail": str(e)}

class DodAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        items = getattr(namespace, self.dest, None)
        if items is None:
            items = []
        else:
            items = list(items)
        if isinstance(values, list):
            items.extend(values)
        else:
            items.append(values)
        setattr(namespace, self.dest, items)

def cmd_call(args):
    payload = {
        "from": args.from_agent or os.environ.get("CUMORA_AGENT_NAME", "system"),
        "to": args.to,
        "timeoutSec": args.timeout,
    }
    if args.context is not None:
        payload["contextId"] = args.context
    if args.task_id:
        payload["taskId"] = args.task_id
    if args.event_version is not None:
        payload["eventVersion"] = args.event_version
    if args.project:
        payload["project"] = args.project
    if args.new_session:
        payload["cleanContext"] = True
        payload["newSession"] = True

    # 当提供结构化参数时，自动组装为结构化 TaskEnvelope
    if args.issue or args.goal or (args.dod and len(args.dod) > 0):
        task_name = args.msg
        if not task_name:
            if args.issue:
                task_name = f"Issue #{args.issue}: {args.goal or ''}".strip()
            else:
                task_name = args.goal or "Structured Task"
        envelope = {
            "task": task_name,
            "goal": args.goal or args.msg or "",
            "dod": args.dod or [],
        }
        if args.project:
            envelope["project"] = args.project
        if args.issue:
            issue_val = str(args.issue).strip().lstrip("#")
            issue_url = issue_val if issue_val.startswith("http") else f"https://github.com/chenyangcun/cumora/issues/{issue_val}"
            envelope["context"] = {
                "issueUrl": issue_url
            }
        payload["envelope"] = envelope
        payload["text"] = json.dumps(envelope, ensure_ascii=False)
    else:
        if not args.msg:
            print("❌ 缺少任务描述: 请提供 --msg 或结构化参数 (--issue, --goal, --dod)", file=sys.stderr)
            sys.exit(1)
        payload["text"] = args.msg

    print(f"🚀 发起任务分发: {payload['from']} ➔ {payload['to']} ...")
    res = make_request("/api/gateway/call", method="POST", body=payload, timeout=args.timeout + 10)
    if res.get("ok"):
        print(f"✅ 任务派发成功！")
        print(f"  • Task ID:    {res.get('gatewayTaskId')}")
        print(f"  • Target:     {args.to}")
        print(f"  • Status:     {res.get('status')}")
    else:
        print(f"❌ 任务派发失败: {res}")
        sys.exit(1)

def cmd_claim(args):
    payload = {}
    if args.token:
        payload["claimToken"] = args.token
    print(f"✍️ 正在执行两阶段认领: {args.task_id} ...")
    res = make_request(f"/api/gateway/tasks/{args.task_id}/claim", method="POST", body=payload)
    if res.get("ok"):
        print(f"✅ 认领成功！任务已进入 DOING 状态。")
        print(f"  • Task ID:    {res.get('gatewayTaskId')}")
        print(f"  • Receipt:    {res.get('claimToken', 'N/A')}")
    else:
        print(f"❌ 认领失败: {res}")
        sys.exit(1)

def cmd_progress(args):
    payload = {
        "percent": args.percent,
        "stage": args.stage,
        "message": args.msg or f"Progress update: {args.stage} ({args.percent}%)",
        # Each invocation is a new heartbeat; a transport retry must reuse this
        # payload/version. Explicit versions allow replay of an earlier event.
        "eventVersion": args.event_version if args.event_version is not None else int(time.time() * 1000),
    }
    res = make_request(f"/api/gateway/tasks/{args.task_id}/progress", method="POST", body=payload)
    if res.get("ok"):
        prog = res.get("progress", {})
        print(f"📡 遥测上报成功: [{prog.get('stage')}] {prog.get('percent')}% · {prog.get('message')}")
    else:
        print(f"❌ 遥测上报失败: {res}")
        sys.exit(1)

def cmd_block(args):
    payload = {
        "reason": args.reason,
    }
    if args.event_version is not None:
        payload["eventVersion"] = args.event_version
    if args.helper:
        payload["helperAgent"] = args.helper
    res = make_request(f"/api/gateway/tasks/{args.task_id}/block", method="POST", body=payload)
    if not res.get("ok") and ("not found" in str(res).lower()) and args.task_id.startswith("issue-"):
        # 外部 GitHub Issue 首次挂起未建档时，自动通过 progress 快速建档并重试 block
        make_request(f"/api/gateway/tasks/{args.task_id}/progress", method="POST", body={
            "percent": 0,
            "stage": "blocked",
            "message": f"Auto-provisioned on block: {args.reason}",
        })
        res = make_request(f"/api/gateway/tasks/{args.task_id}/block", method="POST", body=payload)

    if res.get("ok"):
        print(f"🛑 任务阻碍挂起成功: {args.task_id}")
        print(f"  • Status:        blocked")
        print(f"  • Helper Agent:  @{res.get('helperAgent')}")
        print(f"  • Unblock Task:  {res.get('unblockTaskId')}")
        print(f"  • Message:       {res.get('message')}")
    else:
        print(f"❌ 任务挂起失败: {res}")
        sys.exit(1)

def cmd_complete(args):
    payload = {
        "result": args.result,
    }
    if args.event_version is not None:
        payload["eventVersion"] = args.event_version
    if args.token:
        payload["claimToken"] = args.token
    res = make_request(f"/api/gateway/tasks/{args.task_id}/complete", method="POST", body=payload)
    if not res.get("ok") and ("not found" in str(res).lower()) and args.task_id.startswith("issue-"):
        # 外部 GitHub Issue 结项未建档时，自动建档后重试结项
        make_request(f"/api/gateway/tasks/{args.task_id}/progress", method="POST", body={
            "percent": 100,
            "stage": "completed",
            "message": f"Auto-provisioned on complete: {args.result}",
        })
        res = make_request(f"/api/gateway/tasks/{args.task_id}/complete", method="POST", body=payload)

    if res.get("ok"):
        print(f"🏁 任务交单结项成功: {args.task_id}")
        print(f"  • Status:     completed")
        print(f"  • Result:     {args.result}")
        print(f"  • Callback:   已记录确定性结项通知（不唤醒 Agent）")
    else:
        print(f"❌ 任务结项失败: {res}")
        sys.exit(1)

def cmd_status(args):
    res = make_request(f"/api/gateway/tasks/{args.task_id}")
    if res.get("ok"):
        print(f"📋 任务状态报告: {args.task_id}")
        st = res.get("status")
        st_badge = ""
        if st == "completed":
            st_badge = " 🏁 (已完成)"
        elif st == "running":
            st_badge = " 🟢 (执行中)"
        elif st == "dispatched":
            st_badge = " 📨 (已派发)"
        elif st == "pending":
            st_badge = " ⏳ (待处理)"
        elif st == "blocked":
            st_badge = " 🛑 (已受阻)"
        elif st == "stalled":
            st_badge = " ⚠️ (已停滞)"
        elif st == "failed":
            st_badge = " ❌ (已失败)"
        print(f"  • Status:     {st}{st_badge}")
        prog = res.get("progress", {})
        if prog:
            print(f"  • Progress:   {prog.get('percent')}% ({prog.get('stage')}) - {prog.get('message')}")
        health = res.get("healthState")
        if health:
            h_badge = ""
            if health == "HEALTHY":
                h_badge = " 🟢 (健康)"
            elif health == "PENDING_TELEMETRY":
                h_badge = " ⏳ (派发完成，等待首次遥测自愈)"
            elif health == "BLOCKED":
                h_badge = " 🛑 (已受阻挂起)"
            elif health == "STALLED":
                h_badge = " ⚠️ (心跳失联超时)"
            elif health == "DEAD_LETTER_ALERTED":
                h_badge = " 🚨 (死信已告警)"
            print(f"  • HealthState:{health}{h_badge}")
        if res.get("claimToken"):
            print(f"  • ClaimToken: {res.get('claimToken')}")
        result_text = res.get("result")
        if result_text:
            if getattr(args, "full", False) or len(result_text) <= 300:
                print(f"  • Result:\n{result_text}")
            else:
                print(f"  • Result (前 300 字符，查看完整内容请加 --full):\n{result_text[:300]}...")
    else:
        print(f"❌ 获取状态失败: {res}")
        sys.exit(1)

def cmd_result(args):
    res = make_request(f"/api/gateway/tasks/{args.task_id}")
    if res.get("ok"):
        result_text = res.get("result")
        if result_text:
            print(result_text)
        else:
            print(f"⚠️ 任务 {args.task_id} 尚未生成结果文本 (当前状态: {res.get('status')})")
    else:
        print(f"❌ 获取任务结果失败: {res}")
        sys.exit(1)

def cmd_agents(args):
    res = make_request("/api/gateway/agents")
    if res.get("ok"):
        agents = res.get("agents", [])
        print(f"👥 在线 Agent 花名册 (共 {len(agents)} 位):")
        for a in agents:
            status_badge = "🟢 ONLINE" if a.get("status") == "online" else "⚪ OFFLINE"
            print(f"  • {a.get('name', a.get('id')):<8} ({a.get('id')}): {status_badge} | {a.get('a2aEndpoint')}")
    else:
        print(f"❌ 获取花名册失败: {res}")
        sys.exit(1)

def cmd_logs(args):
    path = f"/api/gateway/calls?limit={args.limit}"
    if args.to:
        path += f"&to={args.to}"
    res = make_request(path)
    if res.get("ok"):
        logs = res.get("logs", [])
        print(f"📑 网关调用审计流水 (最新 {len(logs)} 条):")
        for log in logs:
            badge = "✅" if log.get("status") == "success" else "❌"
            summary = (log.get("summaryText") or "").replace("\n", " ")[:60]
            print(f"  {badge} [{log.get('startedAt', '')[11:19]}] {log.get('fromAgent')} ➔ {log.get('toAgent')} ({log.get('durationMs')}ms) | {summary}")
    else:
        print(f"❌ 获取审计流水失败: {res}")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="Cumora Task & Gateway CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    # call
    p_call = sub.add_parser("call", help="跨 Agent 派发任务")
    p_call.add_argument("--to", required=True, help="目标 Agent ID (如 xiuyuan, qiusuo, chengxu)")
    p_call.add_argument("--msg", help="任务描述或指令正文")
    p_call.add_argument("--context", help="显式 A2A 会话 ID (优先于 Issue/PR 与飞书线程自动派生)")
    p_call.add_argument("--project", help="业务域或项目标签名称 (支持多项目会话槽位隔离)")
    p_call.add_argument("--new-session", dest="new_session", action="store_true", help="强制开辟全新会话 (0ms 短路开新会话，跳过上下文复用)")
    p_call.add_argument("--issue", help="关联 GitHub Issue 编号或 URL (如 65)")
    p_call.add_argument("--goal", help="任务核心目标")
    p_call.add_argument("--dod", nargs="+", action=DodAction, default=[], help="验收标准清单 (DoD)")
    p_call.add_argument("--from-agent", dest="from_agent", help="发起方 Agent ID (默认环境变量 CUMORA_AGENT_NAME 或 system)")
    p_call.add_argument("--timeout", type=int, default=60, help="超时时间 (秒，默认 60)")
    p_call.add_argument("--task-id", help="稳定的业务任务标识（重试保持不变）")
    p_call.add_argument("--event-version", type=int, help="事件版本（重试保持不变；有意重新执行时递增）")
    p_call.set_defaults(func=cmd_call)

    # claim
    p_claim = sub.add_parser("claim", help="两阶段接单认领 (换取 ClaimToken)")
    p_claim.add_argument("task_id", help="网关任务 ID (如 gw_task_xxx 或外部任务如 issue-43)")
    p_claim.add_argument("--token", help="两阶段凭证 (可选)")
    p_claim.set_defaults(func=cmd_claim)

    # progress
    p_prog = sub.add_parser("progress", help="中间进度与心跳遥测上报")
    p_prog.add_argument("task_id", help="网关任务 ID (如 gw_task_xxx 或外部任务如 issue-43)")
    p_prog.add_argument("--percent", type=int, required=True, help="进度百分比 (0-100)")
    p_prog.add_argument("--stage", required=True, help="当前阶段 (如 coding, testing, verifying)")
    p_prog.add_argument("--msg", help="进度说明文字")
    p_prog.add_argument("--event-version", type=int, help="进度事件序号（默认当前毫秒时间；重放时指定原版本）")
    p_prog.set_defaults(func=cmd_progress)

    # complete
    p_comp = sub.add_parser("complete", help="完成交付交单 (记录确定性结项通知，不唤醒模型)")
    p_comp.add_argument("task_id", help="网关任务 ID (如 gw_task_xxx 或外部任务如 issue-43)")
    p_comp.add_argument("--result", required=True, help="结项成果描述或 PR 链接")
    p_comp.add_argument("--token", help="两阶段凭据 (可选)")
    p_comp.add_argument("--event-version", type=int, help="结项事件版本（默认 1）")
    p_comp.set_defaults(func=cmd_complete)

    # block
    p_block = sub.add_parser("block", help="上报阻碍挂起任务 (触发 Jev 智能分诊派生解阻子任务，支持 issue-xx)")
    p_block.add_argument("task_id", help="网关任务 ID (如 gw_task_xxx 或外部任务如 issue-43)")
    p_block.add_argument("--reason", required=True, help="阻碍原因详细描述 (如报错关键字 TS2304 / 502 / PRD 规格歧义)")
    p_block.add_argument("--helper", help="指定协助排查的 Agent (如 qiusuo, xiuyuan, jingan, zhixia；不传则由 Jev 决策模型智能分诊)")
    p_block.add_argument("--event-version", type=int, help="阻塞窗口版本（默认 1；恢复后新阻塞须递增）")
    p_block.set_defaults(func=cmd_block)

    # status
    p_stat = sub.add_parser("status", help="查询任务详情与状态")
    p_stat.add_argument("task_id", help="网关任务 ID (如 gw_task_xxx 或外部任务如 issue-43)")
    p_stat.add_argument("--full", action="store_true", help="打印完整的 Result 交付正文，不作截断")
    p_stat.set_defaults(func=cmd_status)

    # result
    p_res = sub.add_parser("result", help="直接提取并打印任务交付的完整 Markdown 结果正文")
    p_res.add_argument("task_id", help="网关任务 ID (如 gw_task_xxx 或外部任务如 issue-43)")
    p_res.set_defaults(func=cmd_result)

    # agents
    p_agents = sub.add_parser("agents", help="列出网关所有已注册 Agent")
    p_agents.set_defaults(func=cmd_agents)

    # logs
    p_logs = sub.add_parser("logs", help="拉取网关审计流水")
    p_logs.add_argument("--limit", type=int, default=10, help="条数限制 (默认 10)")
    p_logs.add_argument("--to", help="按目标 Agent 过滤")
    p_logs.set_defaults(func=cmd_logs)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
